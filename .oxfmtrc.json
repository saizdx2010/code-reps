{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "ignorePatterns": [
    "src/catalog-index.ts",
    "src/rep-chunks.ts",
    "src/sql-previews.ts",
    "src/review-chunks.ts",
    "**/*.md",
    "**/*.json",
    "index.html",
    "docs/**",
    "public/**"
  ]
}
