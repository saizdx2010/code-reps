{
  "name": "code-reps",
  "private": true,
  "version": "0.0.0",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "package": "yarn build && node scripts/package.mjs",
    "content:check": "node --experimental-strip-types scripts/validate-content.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/maple-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
